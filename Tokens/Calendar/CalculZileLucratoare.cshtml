@inherits PlantAnApp.Tokens.Core.RazorTokenBase
@using System
@using System.Collections.Generic
@using System.Globalization

@{
    //---------------------------------------------------
    // Parametri
    //---------------------------------------------------
    var startParam =
        TokenParameters.Properties["StartDate"] + "";

    var endParam =
        TokenParameters.Properties["EndDate"] + "";

    if (String.IsNullOrWhiteSpace(startParam)
        || String.IsNullOrWhiteSpace(endParam))
    {
        @:0
        return;
    }

    //---------------------------------------------------
    // Formate acceptate
    //---------------------------------------------------
    var formats = new[]
    {
        "MM/dd/yyyy",
        "M/d/yyyy",
        "dd/MM/yyyy",
        "d/M/yyyy"
    };

    DateTime startDate;
    DateTime endDate;

    //---------------------------------------------------
    // Parse StartDate
    //---------------------------------------------------
    if (!DateTime.TryParseExact(
            startParam,
            formats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out startDate))
    {
        @:0
        return;
    }

    //---------------------------------------------------
    // Parse EndDate
    //---------------------------------------------------
    if (!DateTime.TryParseExact(
            endParam,
            formats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out endDate))
    {
        @:0
        return;
    }

    //---------------------------------------------------
    // Normalizează
    //---------------------------------------------------
    startDate = startDate.Date;
    endDate   = endDate.Date;

    //---------------------------------------------------
    // Inversare automată
    //---------------------------------------------------
    if (endDate < startDate)
    {
        var temp = startDate;
        startDate = endDate;
        endDate = temp;
    }

    //---------------------------------------------------
    // Sărbători legale
    //---------------------------------------------------
    var holidays = new HashSet<DateTime>
    {
        new DateTime(2025,1,1),
        new DateTime(2025,1,2),
        new DateTime(2025,1,24),
        new DateTime(2025,4,18),
        new DateTime(2025,4,21),
        new DateTime(2025,5,1),
        new DateTime(2025,6,9),
        new DateTime(2025,8,15),
        new DateTime(2025,12,1),
        new DateTime(2025,12,25),
        new DateTime(2025,12,26)
    };

    //---------------------------------------------------
    // Calcul zile lucrătoare
    //---------------------------------------------------
    int workingDays = 0;

    for (
        var currentDate = startDate;
        currentDate <= endDate;
        currentDate = currentDate.AddDays(1)
    )
    {
        bool isWeekend =
            currentDate.DayOfWeek == DayOfWeek.Saturday
            || currentDate.DayOfWeek == DayOfWeek.Sunday;

        bool isHoliday =
            holidays.Contains(currentDate);

        if (!isWeekend && !isHoliday)
        {
            workingDays++;
        }
    }

    //---------------------------------------------------
    // Return rezultat
    //---------------------------------------------------
    @workingDays
}