@inherits PlantAnApp.Tokens.Core.RazorTokenBase
@using System
@using System.Globalization
@using PlantAnApp.Tokens.Models.Dynamic

@{
    var tknParams = TokenParameters as TknParamsObject;

    if (tknParams == null)
    {
        @:""
        return;
    }

    string startParam =
        tknParams.Properties.ContainsKey("StartDate")
            ? tknParams.Properties["StartDate"].ToString()
            : "";

    string endParam =
        tknParams.Properties.ContainsKey("EndDate")
            ? tknParams.Properties["EndDate"].ToString()
            : "";

    DateTime startDate;
    DateTime endDate;

   var formats = new[] {
        "MM/dd/yyyy",
        "M/d/yyyy",
        "MM/d/yyyy",
        "M/dd/yyyy"
    };


    if (!DateTime.TryParseExact(
            startParam,
            formats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out startDate))
    {
        @:""
        return;
    }

    if (!DateTime.TryParseExact(
            endParam,
            formats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out endDate))
    {
        @:""
        return;
    }
    
        if (endDate < startDate)
        {
            @:""
             return;
        }

    DateTime luna3 =
        new DateTime(startDate.Year, startDate.Month, 1)
        .AddMonths(2);

    if (endDate < luna3)
    {
        @:""
        return;
    }

    DateTime sfarsitLuna3 =
        new DateTime(
            luna3.Year,
            luna3.Month,
            DateTime.DaysInMonth(
                luna3.Year,
                luna3.Month));

    DateTime rezultat =
        endDate <= sfarsitLuna3
            ? endDate
            : sfarsitLuna3;

    @rezultat.ToString("MM/dd/yyyy")
}