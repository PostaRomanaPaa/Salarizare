@inherits PlantAnApp.Tokens.Core.RazorTokenBase
@using System
@using System.Collections.Generic
@using System.Globalization
@using PlantAnApp.Tokens.Models.Dynamic

@{
    var tknParams = TokenParameters as TknParamsObject;

    if (tknParams == null)
    {
        @:0
        return;
    }

    string startParam =
        tknParams.Properties.ContainsKey("StartDate")
            ? tknParams.Properties["StartDate"].ToString()
            : "";

    string endParam =
        tknParams.Properties.ContainsKey("EndDate")
            ? tknParams.Properties["EndDate"].ToString()
            : "";

    DateTime startDate;
    DateTime endDate;

    var formats = new[]
    {
        "MM/dd/yyyy",
        "M/d/yyyy",
        "MM/d/yyyy",
        "M/dd/yyyy"
    };

    if (!DateTime.TryParseExact(startParam, formats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out startDate))
    {
        @:0
        return;
    }

    if (!DateTime.TryParseExact(endParam, formats,
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out endDate))
    {
        @:0
        return;
    }

    DateTime luna3 =
        new DateTime(startDate.Year, startDate.Month, 1)
        .AddMonths(2);

    if (endDate < luna3)
    {
        @:0
        return;
    }

    DateTime intervalStart = luna3;

    DateTime sfarsitLuna3 =
        new DateTime(
            luna3.Year,
            luna3.Month,
            DateTime.DaysInMonth(
                luna3.Year,
                luna3.Month));

    DateTime intervalEnd =
        endDate <= sfarsitLuna3
            ? endDate
            : sfarsitLuna3;

    
    //-------------------------------------------------
    // Sarbatori legale
    //-------------------------------------------------

    var holidays = new HashSet<DateTime>
    {
        // 2025
    new DateTime(2025,1,1),
    new DateTime(2025,1,2),
    new DateTime(2025,1,6),
    new DateTime(2025,1,7),
    new DateTime(2025,1,24),
    new DateTime(2025,4,18),
    new DateTime(2025,4,20),
    new DateTime(2025,4,21),
    new DateTime(2025,5,1),
    new DateTime(2025,6,1),
    new DateTime(2025,6,8),
    new DateTime(2025,6,9),
    new DateTime(2025,8,15),
    new DateTime(2025,11,30),
    new DateTime(2025,12,1),
    new DateTime(2025,12,25),
    new DateTime(2025,12,26),
    
        // 2026
        new DateTime(2026,1,1),
        new DateTime(2026,1,2),
        new DateTime(2026,1,6),
        new DateTime(2026,1,7),
        new DateTime(2026,1,24),
        new DateTime(2026,4,10),
        new DateTime(2026,4,12),
        new DateTime(2026,4,13),
        new DateTime(2026,5,1),
        new DateTime(2026,5,31),
        new DateTime(2026,6,1),
        new DateTime(2026,8,15),
        new DateTime(2026,11,30),
        new DateTime(2026,12,1),
        new DateTime(2026,12,25),
        new DateTime(2026,12,26),

        // 2027
        new DateTime(2027,1,1),
        new DateTime(2027,1,2),
        new DateTime(2027,1,6),
        new DateTime(2027,1,7),
        new DateTime(2027,1,24),
        new DateTime(2027,4,30),
        new DateTime(2027,5,1),
        new DateTime(2027,5,2),
        new DateTime(2027,5,3),
        new DateTime(2027,6,1),
        new DateTime(2027,6,20),
        new DateTime(2027,6,21),
        new DateTime(2027,8,15),
        new DateTime(2027,11,30),
        new DateTime(2027,12,1),
        new DateTime(2027,12,25),
        new DateTime(2027,12,26)
    };


    int zile = 0;

    for (var d = intervalStart.Date;
         d <= intervalEnd.Date;
         d = d.AddDays(1))
    {
        bool isWeekend =
            d.DayOfWeek == DayOfWeek.Saturday ||
            d.DayOfWeek == DayOfWeek.Sunday;

        bool isHoliday =
            holidays.Contains(d.Date);

        if (!isWeekend && !isHoliday)
        {
            zile++;
        }
    }

    @zile
}