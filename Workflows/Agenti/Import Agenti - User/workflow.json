          {
            "Id": 666,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 2896,
            "Name": "SqlQuery",
            "Value": ";WITH Parametri AS (\r\n    SELECT [Initializari:ZileLucratoare_old(Anul = [Anul], Luna = [Luna])] AS ZileLucratoare\r\n),\r\nSalariatiFaraZile AS (\r\n    SELECT a.Marca\r\n    FROM app.Salariat a\r\n    CROSS JOIN Parametri p\r\n    OUTER APPLY (\r\n        SELECT SUM(ISNULL(c.NrZileCO1, 0) + ISNULL(c.NrZileCO2, 0) + ISNULL(c.NrZileCO3, 0)) AS ZileCO\r\n        FROM app.ConcediudeOdihna c\r\n        WHERE c.Marca = a.Marca \r\n          AND c.CodSucursala = a.CodSucursala\r\n          AND (\r\n               (MONTH(c.Interval1DatadeInceput) = @Luna AND YEAR(c.Interval1DatadeInceput) = @Anul) OR\r\n               (MONTH(c.Interval2DatadeInceput) = @Luna AND YEAR(c.Interval2DatadeInceput) = @Anul) OR\r\n               (MONTH(c.Interval3DatadeInceput) = @Luna AND YEAR(c.Interval3DatadeInceput) = @Anul)\r\n          )\r\n    ) co\r\n    OUTER APPLY (\r\n        SELECT SUM(m.TotZileLucratoare) AS ZileCM\r\n        FROM app.ConcediuMedical m\r\n        WHERE m.Marca = a.Marca \r\n          AND m.AnulDePlata = @Anul \r\n          AND m.LunaDePlata = @Luna\r\n          AND m.CodSucursala = @CodSucursala\r\n    ) cm\r\n    WHERE a.Anul = @Anul \r\n      AND a.Luna = @Luna \r\n      AND a.CodSucursala = @CodSucursala\r\n      AND (p.ZileLucratoare - ISNULL(co.ZileCO, 0) - ISNULL(cm.ZileCM, 0)) <= 0\r\n)\r\n-- Folosim ISNULL pe un subquery pentru a decide statusul dintr-o singură lovitură\r\nSELECT ISNULL(\r\n    (SELECT TOP 1 'GASIT' \r\n     FROM app.Agent ag \r\n     WHERE ag.Anul = @Anul AND ag.Luna = @Luna AND ag.CodSucursala = @CodSucursala \r\n     AND ag.Marca IN (SELECT Marca FROM SalariatiFaraZile)), \r\n    'CURAT'\r\n) AS RezultatErori;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
