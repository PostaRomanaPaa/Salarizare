                    },
                    {
                      "Id": 27504,
                      "GlobalId": "00000000-0000-0000-0000-000000000000",
                      "ActionId": 6519,
                      "Name": "SqlQuery",
                      "Value": "WITH Sume AS\r\n(\r\n    SELECT 'BCR' AS CodBanca, Marca, Suma, Luna, Anul, CodSucursala, TipPlata, DataPlatii, DenumireFisier\r\n    FROM app.SumaBCR\r\n    WHERE Status = 2\r\n\r\n    UNION ALL\r\n    SELECT 'BRD', Marca, Suma, Luna, Anul, CodSucursala, TipPlata, DataPlatii, DenumireFisier\r\n    FROM app.SumaBRD\r\n    WHERE Status = 1\r\n\r\n    UNION ALL\r\n    SELECT 'BT', Marca, Suma, Luna, Anul, CodSucursala, TipPlata, DataPlatii, DenumireFisier\r\n    FROM app.SumaBT\r\n    WHERE Status = 1\r\n\r\n    UNION ALL\r\n    SELECT 'CEC', Marca, Suma, Luna, Anul, CodSucursala, TipPlata, DataPlatii, DenumireFisier\r\n    FROM app.SumaCEC\r\n    WHERE Status = 1\r\n\r\n    UNION ALL\r\n    SELECT 'ING', Marca, Suma, Luna, Anul, CodSucursala, TipPlata, DataPlatii, DenumireFisier\r\n    FROM app.SumaING\r\n    WHERE Status = 1\r\n\r\n    UNION ALL\r\n    SELECT 'MIL', Marca, Suma, Luna, Anul, CodSucursala, TipPlata, DataPlatii, DenumireFisier\r\n    FROM app.SumaMIL\r\n    WHERE Status = 1\r\n\r\n    UNION ALL\r\n    SELECT 'RZB', Marca, Suma, Luna, Anul, CodSucursala, TipPlata, DataPlatii, DenumireFisier\r\n    FROM app.SumaRZB\r\n    WHERE Status = 1\r\n\r\n    UNION ALL\r\n    SELECT 'UNI', Marca, Suma, Luna, Anul, CodSucursala, TipPlata, DataPlatii, DenumireFisier\r\n    FROM app.SumaUNI\r\n    WHERE Status = 1\r\n)\r\n\r\nINSERT INTO app.BancaFisierTransfer\r\n(\r\n    IdCentr,\r\n    CodSucursala,\r\n    Anul,\r\n    Luna,\r\n    CodBanca,\r\n    DenumireBanca,\r\n    EmailDestinatar,\r\n    MesajTransmitere,\r\n    DataPlatii,\r\n    TipPlata,\r\n    DenumireFisier,\r\n    NumarSalariati,\r\n    ValoareTotala,\r\n    Status,\r\n    CreatedDate\r\n    \r\n)\r\nSELECT\r\n    ROW_NUMBER() OVER\r\n    (\r\n     ORDER BY\r\n            CAST(s.DataPlatii AS DATE),\r\n            bc.CodBanca,\r\n            s.TipPlata\r\n    ) AS IdCentr,\r\n\r\n    s.CodSucursala,\r\n    s.Anul,\r\n    s.Luna,\r\n\r\n    bc.CodBanca,\r\n    bc.DenumireBanca,\r\n    bc.EmailCNPR,\r\n    '' AS MesajTransmitere,\r\n\r\n   CAST(s.DataPlatii AS DATE) AS DataPlatii,\r\n\r\n    s.TipPlata,\r\n    s.DenumireFisier,\r\n\r\n    COUNT(*) AS NumarSalariati,\r\n\r\n    SUM(ISNULL(s.Suma,0)) AS ValoareTotala,\r\n\r\n    1 AS Status,\r\n    GETDATE() AS CreatedDate\r\n\r\nFROM Sume s\r\n\r\nINNER JOIN app.BancaCard bc\r\n    ON bc.CodBanca = s.CodBanca\r\n\r\nWHERE s.CodSucursala = @CodSucursala\r\n  AND s.Luna         = @Luna\r\n  AND s.Anul         = @Anul\r\n\r\n  AND NOT EXISTS\r\n(\r\n    SELECT 1\r\n    FROM app.BancaFisierTransfer bft\r\n    WHERE bft.CodSucursala = s.CodSucursala\r\n      AND bft.Anul         = s.Anul\r\n      AND bft.Luna         = s.Luna\r\n      AND bft.CodBanca     = bc.CodBanca\r\n      AND bft.TipPlata     = s.TipPlata\r\n      AND bft.DataPlatii   = CAST(s.DataPlatii AS DATE)\r\n)\r\n  AND (\r\n        TRY_CAST(@DataPlatii AS DATE) IS NULL\r\n        OR CAST(s.DataPlatii AS DATE) = TRY_CAST(@DataPlatii AS DATE)\r\n      )\r\n  AND (\r\n        @TipPlata IS NULL\r\n        OR @TipPlata = ''\r\n        OR s.TipPlata = @TipPlata\r\n      )\r\nGROUP BY\r\n    s.CodSucursala,\r\n    s.Anul,\r\n    s.Luna,\r\n    bc.CodBanca,\r\n    bc.DenumireBanca,\r\n    bc.EmailCNPR,\r\n    s.DenumireFisier,\r\n    CAST(s.DataPlatii AS DATE),\r\n    s.TipPlata;",
                      "ActionStackId": null,
                      "ParentParameterId": null,
                      "IsExpression": false,
                      "OrderIndex": 0,
                      "LastModified": "0001-01-01T00:00:00+00:00",
                      "LastModifiedBy": null
