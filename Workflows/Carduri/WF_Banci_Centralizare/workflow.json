            "ActionId": 6517,
            "Name": "SqlQuery",
            "Value": "DELETE FROM app.BancaFisierTransfer\r\nWHERE CodSucursala = @CodSucursala\r\n  AND Luna         = @Luna\r\n  AND Anul         = @Anul\r\n  AND (\r\n        TRY_CAST(@DataPlatii AS DATE) IS NULL\r\n        OR DataPlatii = TRY_CAST(@DataPlatii AS DATE)\r\n      )\r\n  AND (\r\n        @TipPlata IS NULL\r\n        OR @TipPlata = ''\r\n        OR TipPlata = @TipPlata\r\n      );",
