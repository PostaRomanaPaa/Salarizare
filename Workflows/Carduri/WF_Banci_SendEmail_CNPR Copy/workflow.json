            "ActionId": 7658,
            "Name": "SqlQuery",
            "Value": "SELECT\n    Id,\n    FileId,\n    CodBanca,\n    DenumireFisier,\n    @Email as EmailDestinatarFormular,\n    TipPlata,\n    DataPlatii,\n    CodSucursala,\n    Luna,\n    Anul\nFROM app.BancaFisierTransfer\nWHERE Status = 8\n  AND FileId IS NOT NULL\n  AND CodSucursala = @CodSucursala\n  AND Luna = @Luna\n  AND Anul = @Anul\n  --AND CAST(DataPlatii AS DATE) = CAST(@DataPlatii AS DATE)\n  AND LTRIM(RTRIM(TipPlata)) = LTRIM(RTRIM(@TipPlata))\nORDER BY CodBanca, DenumireFisier;",
