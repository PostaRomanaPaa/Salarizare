          {
            "Id": 34130,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 7870,
            "Name": "SqlQuery",
            "Value": "SELECT STRING_AGG(FileId, ',') AS FileIds, STRING_AGG('<li>'+ DenumireFisier, '</li>') AS NumeFisiere\r\nFROM app.BancaFisierTransfer\r\nWHERE Status = 8\r\n  AND FileId IS NOT NULL\r\n  AND CodSucursala = @CodSucursala\r\n  AND Luna = @Luna\r\n  AND Anul = @Anul\r\n  AND DataPlatii = CONVERT(date, @DataPlatii)\r\n  AND LTRIM(RTRIM(TipPlata)) = LTRIM(RTRIM(@TipPlata))",
            "ActionStackId": null,
            "ParentParameterId": null,
