            "ActionId": 7872,
            "Name": "SqlQuery",
            "Value": "UPDATE app.BancaFisierTransfer\r\nSET\r\n    Status = 4,\r\n    DataTransmitere = GETDATE(),\r\n    EmailDestinatar = @Email,\r\n    MesajTransmitere = 'Fisier transmis prin Email cu succes'\r\nWHERE FileId IN (\r\n    SELECT TRY_CAST(value AS INT)\r\n    FROM STRING_SPLIT(@ListaFisiere, ',')\r\n)",
