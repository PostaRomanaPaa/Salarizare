          {
            "Id": 26984,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 6407,
            "Name": "SqlQuery",
            "Value": "SELECT\n    Id,\n    FileId,\n    CodBanca,\n    DenumireFisier,\n    EmailDestinatar,\n    TipPlata,\n    DataPlatii,\n    CodSucursala,\n    Luna,\n    Anul\nFROM app.BancaFisierTransfer\nWHERE Status IN (8,9)\n  AND FileId IS NOT NULL\n\n  AND CodSucursala = @CodSucursala\n  AND Luna         = @Luna\n  AND Anul         = @Anul\n\n  AND (\n        @DataPlatii IS NULL\n        OR DataPlatii = CAST(@DataPlatii AS DATE)\n      )\n\n  AND (\n        @TipPlata IS NULL\n        OR @TipPlata = ''\n        OR TipPlata = @TipPlata\n      )\n\nORDER BY CodBanca;",
