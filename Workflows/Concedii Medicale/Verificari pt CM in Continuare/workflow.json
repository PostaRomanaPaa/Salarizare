          },
          {
            "Id": 488,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 2874,
            "Name": "SqlQuery",
            "Value": "SELECT\r\n    CASE\r\n        WHEN NULLIF(LTRIM(RTRIM(ISNULL(@Marca, ''))), '') IS NULL\r\n            THEN 'Lipsa_Marca'\r\n\r\n        WHEN TRY_CONVERT(date, @DatadeInceput, 101) IS NULL\r\n            THEN 'Data_inceput_invalida'\r\n\r\n        WHEN NOT EXISTS\r\n        (\r\n            SELECT 1\r\n            FROM app.ConcediuMedical\r\n            WHERE LTRIM(RTRIM(ISNULL(Marca, ''))) = LTRIM(RTRIM(ISNULL(@Marca, '')))\r\n              AND LTRIM(RTRIM(ISNULL(CodSucursala, ''))) = LTRIM(RTRIM(ISNULL(@CodSucursala, '')))\r\n              AND DatadeInceput IS NOT NULL\r\n              AND DatadeSfarsit IS NOT NULL\r\n              AND DatadeSfarsit < TRY_CONVERT(date, @DatadeInceput, 101)\r\n        )\r\n            THEN 'Lipsa_CM_initial'\r\n\r\n        ELSE 'OK'\r\n    END AS StatusValidare;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
