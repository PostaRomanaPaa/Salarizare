          },
          {
            "Id": 546,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 2881,
            "Name": "SqlQuery",
            "Value": "WITH LunaCurenta AS (\r\n    SELECT \r\n        DATEFROMPARTS(@AnSesCurenta, @LunaSesCurenta, 1) AS PrimaZi,\r\n        EOMONTH(DATEFROMPARTS(@AnSesCurenta, @LunaSesCurenta, 1)) AS UltimaZi\r\n),\r\n\r\nCMInitial AS (\r\n    SELECT TOP 1 \r\n        Id,\r\n        SerieCM,\r\n        NrCM,\r\n        DatadeInceput,\r\n        DatadeSfarsit\r\n    FROM app.ConcediuMedical\r\n    WHERE Marca = @Marca\r\n      AND CodCertMed = @CodCertMed\r\n      AND CMContinuare = 'N'\r\n      AND DatadeSfarsit <= (SELECT UltimaZi FROM LunaCurenta)\r\n      AND @DatadeInceputNou = DATEADD(DAY, 1, DatadeSfarsit)\r\n    ORDER BY DatadeSfarsit DESC\r\n)\r\n\r\nSELECT \r\n    c.Id AS CMInitialId,\r\n    c.SerieCM AS SerieCMInitial,\r\n    c.NrCM AS NrCMInitial,\r\n    CASE \r\n        WHEN c.Id IS NOT NULL THEN 1 ELSE 0 \r\n    END AS IsContinuareValida,\r\n    CASE \r\n        WHEN c.Id IS NULL THEN 'Nu exista un CM initial valid pentru continuitate.'\r\n        ELSE 'Continuarea este valida si s-au preluat datele CM initial.'\r\n    END AS Mesaj\r\nFROM CMInitial c;\r\n",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
