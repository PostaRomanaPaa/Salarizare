                    },
                    {
                      "Id": 1910,
                      "Name": "SqlQuery",
                      "Value": "SELECT COUNT(*) AS NrExistente\r\nFROM app.Agent\r\nWHERE Anul = @Anul \r\n  AND Luna = @Luna \r\n  -- Folosim CAST pentru a ne asigura că TRIM primește un string, evitând eroarea de tip de date\r\n  AND TRIM(CAST(CodSucursala AS NVARCHAR(450))) = TRIM(CAST(@CodSucursala AS NVARCHAR(450)))\r\n  AND TRIM(CAST(Marca AS NVARCHAR(450))) = TRIM(CAST(@Marca AS NVARCHAR(450)))\r\n  \r\n  -- Tratăm CodPrestatie care poate fi NULL sau gol\r\n  AND ISNULL(TRIM(CAST(CodPrestatie AS NVARCHAR(450))), '') = ISNULL(TRIM(CAST(@CodPrestatie AS NVARCHAR(450))), '')\r\n  \r\n  -- Suma: Ambele sunt Decimal(18), deci comparăm direct sau cu ABS pentru siguranță\r\n  AND ABS(CAST(ISNULL(Suma, 0) AS DECIMAL(18,2)) - CAST(ISNULL(@Suma, 0) AS DECIMAL(18,2))) < 0.01",
                      "ParentParameterId": null,
                      "IsExpression": false,
                      "ActionId": 247,
                      "OrderIndex": 0
                    },
