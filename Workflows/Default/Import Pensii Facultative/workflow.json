          {
            "Id": 2254,
            "Name": "SqlQuery",
            "Value": "insert into app.Retinere\r\n(\r\n    TipRata,\r\n    Marca,\r\n    NumarCurent,\r\n    CodBeneficiar,\r\n    Rata,\r\n    Dobanda,\r\n    RestdePlata,\r\n    NumarContract,\r\n    FondRulment,\r\n    CodSucursala,\r\n    Judet,\r\n    Luna,\r\n    Anul,\r\n    CreatedDate\r\n)\r\nselect\r\n    7,\r\n    pf.Marca,\r\n    --isnull(\r\n    --    (select max(r.NumarCurent) + 1 \r\n    --     from app.Retinere r \r\n    --     where r.Marca = pf.Marca),\r\n    --    1\r\n    --),\r\n    1,\r\n    pf.CodBeneficiar,\r\n    pf.ContributieTotala,\r\n    0,\r\n    0,\r\n    pf.Cont,\r\n    pf.ContributieTotala,\r\n    pf.CodSucursala,\r\n    substring(pf.Marca,2,2),\r\n    pf.Luna,\r\n    pf.Anul,\r\n    getdate()\r\nfrom app.PensieFacultativa pf\r\nwhere pf.CodSucursala = @CodSucursala\r\n  and pf.Luna = @Luna\r\n  and pf.Anul = @Anul\r\n  and pf.CodBeneficiar = @CodBeneficiar\r\n  --or  Fisier = @Fisier\r\n\r\n  and not exists (\r\n        select 1\r\n        from app.Retinere r\r\n        where r.Marca = pf.Marca\r\n          and r.CodBeneficiar = pf.CodBeneficiar\r\n          and r.Luna = pf.Luna\r\n          and r.Anul = pf.Anul\r\n          and r.TipRata = 7\r\n)",
            "ParentParameterId": null,
            "IsExpression": false,
            "ActionId": 295,
            "OrderIndex": 0
          },
