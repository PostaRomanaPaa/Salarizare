          {
            "Id": 1000,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 2934,
            "Name": "SqlQuery",
            "Value": "SELECT Distinct p.CodSucursala,p.Anul,p.Luna,\n    p.CodBeneficiar,\n   UPPER(e.TipFisier) as TipFisier,\n    e.Email\nFROM app.PensieFacultativa p\nINNER JOIN app.PensieFacultativaEmail e \n    ON e.CodBeneficiar = p.CodBeneficiar\nWHERE \n    p.Anul = @Anul\n    AND p.Luna = @Luna\n    AND p.CodSucursala = @CodSucursala\n",
