          {
            "Id": 2888,
            "Name": "SqlQuery",
            "Value": "UPDATE pf\nSET \n    pf.ContributiePersonalaRetinuta = ISNULL(r.Suma, 0),\n    pf.ContributieAngajatorVirata = 0,\n    pf.ContributieTotalaVirata = ISNULL(r.Suma, 0)\nFROM app.PensieFacultativa pf\nLEFT JOIN (\n    SELECT \n        Marca,\n        CodBeneficiar,\n        SUM(ISNULL(Rata,0) + ISNULL(Dobanda,0) + ISNULL(RestDePlata,0)) AS Suma\n    FROM app.Retinere\n    WHERE \n        TipRata = 7\n        AND Anul = @Anul\n        AND Luna = @Luna\n        AND CodSucursala = @CodSucursala\n    GROUP BY Marca, CodBeneficiar\n) r\nON pf.Marca = r.Marca\nAND pf.CodBeneficiar = r.CodBeneficiar\nAND pf.Anul = @Anul\nAND pf.Luna = @Luna\nAND pf.CodSucursala = @CodSucursala\nWHERE \n    pf.Anul = @Anul\n    AND pf.Luna = @Luna\n    AND pf.CodSucursala = @CodSucursala",
            "ParentParameterId": null,
            "IsExpression": false,
            "ActionId": 368,
            "OrderIndex": 0
          },
