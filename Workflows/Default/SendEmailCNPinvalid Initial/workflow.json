          {
            "Id": 818,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 2915,
            "Name": "SqlQuery",
            "Value": "select \r\n    max(Fisier) as Fisier,\r\n    count(*) as Total,\r\n   string_agg(\r\n    '<tr style=\"line-height:12px;\">' +\r\n    '<td style=\"padding:2px 4px;\">' + CNP + '</td>' +\r\n    '<td style=\"padding:2px 4px;\">' + Nume + '</td>' +\r\n    '<td style=\"padding:2px 4px;\">' + Mesaj + '</td>' +\r\n    '<td style=\"padding:2px 4px;\">' + Fisier + '</td>' +\r\n    '</tr>'\r\n, '') as RowsHTML\r\nfrom app.PensieFacEroare\r\nwhere CodSucursala = @CodSucursala\r\n  and Anul = @Anul\r\n  and Luna = @Luna\r\n  and Fisier = @Fisier",
