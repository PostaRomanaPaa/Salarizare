            "Value": {
              "Id": 359,
              "EventName": "click",
              "Actions": [
                {
                  "Id": 319,
                  "Description": "CNP Invalide",
                  "ActionErrorMessage": null,
                  "Condition": null,
                  "ActionType": "RunSql",
                  "OrderIndex": 0,
                  "IsDisabled": false,
                  "ActionParameters": [
                    {
                      "Id": 2420,
                      "Name": "ConnectionString",
                      "Value": null,
                      "ParentParameterId": null,
                      "IsExpression": false,
                      "ActionId": 319,
                      "OrderIndex": 0
                    },
                    {
                      "Id": 2421,
                      "Name": "QueryTimeout",
                      "Value": null,
                      "ParentParameterId": null,
                      "IsExpression": false,
                      "ActionId": 319,
                      "OrderIndex": 0
                    },
                    {
                      "Id": 2422,
                      "Name": "SqlQuery",
                      "Value": "SELECT \r\n    ROW_NUMBER() OVER (ORDER BY e.Fisier) as Id,\r\n\r\n    e.Fisier,\r\n    COUNT(*) as Total,\r\n\r\n    tf.TipFisier,\r\n    e.Status,\r\n\r\n    '<table border=\"1\" cellspacing=\"0\" cellpadding=\"3\">' +\r\n    '<tr style=\"font-weight:bold;\">' +\r\n    '<td>CNP</td><td>Nume</td><td>Mesaj</td><td>Fisier</td>' +\r\n    '</tr>' +\r\n\r\n    STRING_AGG(\r\n        '<tr style=\"line-height:12px;\">' +\r\n        '<td>' + e.CNP + '</td>' +\r\n        '<td>' + e.Nume + '</td>' +\r\n        '<td>' + e.Mesaj + '</td>' +\r\n        '<td>' + e.Fisier + '</td>' +\r\n        '</tr>'\r\n    , '') \r\n\r\n    + '</table>' as RowsHTML,\r\n\r\n    COALESCE(m.Email, 'maria.mardare@ro.post') as Email\r\n\r\nFROM app.PensieFacEroare e\r\n\r\nCROSS APPLY (\r\n    SELECT \r\n        CASE \r\n            WHEN e.Fisier LIKE '%alzm%' THEN 'alzm'\r\n            WHEN e.Fisier LIKE '%alzv%' THEN 'alzv'\r\n            WHEN e.Fisier LIKE '%aviva%' THEN 'aviva'\r\n            WHEN e.Fisier LIKE '%bcr%' THEN 'bcr'\r\n            WHEN e.Fisier LIKE '%ingc%' THEN 'ingc'\r\n            ELSE 'default'\r\n        END as TipFisier\r\n) tf\r\n\r\n JOIN app.PensieFacultativaEmail m\r\n    ON m.TipFisier = tf.TipFisier\r\n\r\nWHERE \r\n    e.CodSucursala = @CodSucursala\r\n    AND e.Anul = @Anul\r\n    AND e.Luna = @Luna\r\n    AND m.Email = '[EmailList:Email]' and tf.TipFisier = '[EmailList:TipFisier]'\r\n\r\n\r\nGROUP BY \r\n    e.Fisier,\r\n    tf.TipFisier,\r\n    e.status,\r\n    m.Email",
                      "ParentParameterId": null,
                      "IsExpression": false,
                      "ActionId": 319,
                      "OrderIndex": 0
                    },
