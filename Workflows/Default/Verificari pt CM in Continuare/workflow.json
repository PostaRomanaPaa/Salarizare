          {
            "Id": 1689,
            "Name": "SqlQuery",
            "Value": "SELECT CASE \r\n    WHEN NOT EXISTS (\r\n        SELECT 1 \r\n        FROM app.ConcediuMedical \r\n        WHERE Marca = @Marca \r\n          AND CodCertMedical = @CodCertMedical\r\n    ) THEN 'Lipsa_CM_initial'\r\n\r\n    WHEN (\r\n        SELECT TOP 1 DATEADD(DAY, 1, DatadeSfarsit)\r\n        FROM app.ConcediuMedical\r\n        WHERE Marca = @Marca \r\n          AND CodCertMedical = @CodCertMedical\r\n        ORDER BY DatadeSfarsit DESC\r\n    ) != @DatadeInceput THEN 'Data_neconsecutiva'\r\n\r\n    ELSE 'OK'\r\nEND AS StatusValidare;\r\n",
            "ParentParameterId": null,
