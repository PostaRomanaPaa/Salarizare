          {
            "Id": 28792,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 6795,
            "Name": "SqlQuery",
            "Value": "SELECT\r\n    a.CodSucursala,\r\n    a.Anul,\r\n    a.Luna,\r\n    a.Marca,\r\n    a.Nume,\r\n    COUNT(c.Id) AS NumarCopii,\r\n    @Suma AS Suma,\r\n    COUNT(c.Id) * @Suma AS PrimaNet\r\nFROM app.Salariat a\r\nLEFT JOIN app.Copil c\r\n    ON a.Marca = c.Marca\r\nWHERE a.CodSucursala = @CodSucursala\r\n  AND a.Anul = @Anul\r\n  AND a.Luna = @Luna\r\nGROUP BY\r\n    a.CodSucursala,\r\n    a.Anul,\r\n    a.Luna,\r\n    a.Marca,\r\n    a.Nume\r\nHAVING COUNT(c.Id) <> 0",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
