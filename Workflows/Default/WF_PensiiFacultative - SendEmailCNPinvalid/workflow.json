            "ActionId": 2920,
            "Name": "SqlQuery",
            "Value": "SELECT \r\n    p.Email,\r\n    p.TipFisier,\r\n    COUNT(*) as Total\r\nFROM app.PensieFacultativaEmail p\r\n\r\nJOIN app.PensieFacEroare e\r\n    ON e.Fisier LIKE '%' + p.TipFisier + '%'\r\n\r\nWHERE \r\n    --e.Mesaj = 'CNP Invalid' and \r\n    e.status=1\r\n\r\nGROUP BY \r\n    p.Email,\r\n    p.TipFisier",
