                    {
                      "Id": 889,
                      "GlobalId": "00000000-0000-0000-0000-000000000000",
                      "ActionId": 2922,
                      "Name": "SqlQuery",
                      "Value": "UPDATE e\r\nSET \r\n    e.Status = 4,\r\n    e.DataTransmitere = GETDATE()\r\nFROM app.PensieFacEroare e\r\n\r\nCROSS APPLY (\r\n    SELECT \r\n        CASE \r\n            WHEN e.Fisier LIKE '%alzm%' THEN 'alzm'\r\n            WHEN e.Fisier LIKE '%alzv%' THEN 'alzv'\r\n            WHEN e.Fisier LIKE '%aviva%' THEN 'aviva'\r\n            WHEN e.Fisier LIKE '%bcr%' THEN 'bcr'\r\n            WHEN e.Fisier LIKE '%ingc%' THEN 'ingc'\r\n            ELSE 'default'\r\n        END as TipFisier\r\n) tf\r\n\r\nLEFT JOIN app.PensieFacultativaEmail m\r\n    ON m.TipFisier = tf.TipFisier\r\n\r\nWHERE \r\n  m.Email = '[EmailList:Email]' and tf.TipFisier = '[EmailList:TipFisier]'\r\n    AND e.Mesaj = 'CNP Invalid'\r\n    AND e.Status = 1",
