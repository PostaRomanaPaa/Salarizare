          {
            "Id": 1033,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 2938,
            "Name": "SqlQuery",
            "Value": "SELECT DISTINCT \n    p.CodBeneficiar,\n    e.TipFisier,\n    e.Email\nFROM app.PensieFacultativa p\nLEFT JOIN app.PensieFacultativaEmail e\n    ON e.CodBeneficiar = p.CodBeneficiar\nWHERE \n    p.Anul = @Anul\n    AND p.Luna = @Luna\n    AND p.CodSucursala = @CodSucursala\n    AND p.ContributieTotalaVirata > 0",
