                      "Value": "SELECT p.id,\n    p.CNP,\n    p.Nume,\n    p.Cont,\n    p.CodBeneficiar,\n    p.Luna,\n    p.Anul,\n    p.ContributiePersonalaretinuta,\n    p.ContributieAngajatorVirata,\n    p.ContributieTotalaVirata,\n    e.TipFisier,\n    e.Email\nFROM app.PensieFacultativa p\nINNER JOIN app.PensieFacultativaEmail e \n    ON e.CodBeneficiar = p.CodBeneficiar\n\nWHERE \n    p.Anul = @Anul\n    AND p.Luna = @Luna\n    AND p.CodSucursala = @CodSucursala\n    AND p.CodBeneficiar = @CodBen\n    AND p.ContributieTotalaVirata > 0",
                      "ActionStackId": null,
                      "ParentParameterId": null,
                      "IsExpression": false,
                      "OrderIndex": 0,
                      "LastModified": "0001-01-01T00:00:00+00:00",
