          },
          {
            "Id": 30372,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 7257,
            "Name": "SqlQuery",
            "Value": ";WITH CarduriBanci AS\r\n(\r\n    SELECT Marca, CodSucursala, 'BCR' AS CodBanca, ContIBAN FROM app.CardBCR\r\n    UNION ALL\r\n    SELECT Marca, CodSucursala, 'BRD', ContIBAN FROM app.CardBRD\r\n    UNION ALL\r\n    SELECT Marca, CodSucursala, 'BT',  ContIBAN FROM app.CardBT\r\n    UNION ALL\r\n    SELECT Marca, CodSucursala, 'CEC', ContIBAN FROM app.CardCEC\r\n    UNION ALL\r\n    SELECT Marca, CodSucursala, 'ING', ContIBAN FROM app.CardING\r\n    UNION ALL\r\n    SELECT Marca, CodSucursala, 'MIL', ContIBAN FROM app.CardMIL\r\n    UNION ALL\r\n    SELECT Marca, CodSucursala, 'RZB', ContIBAN FROM app.CardRZB\r\n    UNION ALL\r\n    SELECT Marca, CodSucursala, 'UNI', ContIBAN FROM app.CardUNI\r\n),\r\n\r\nCarduri AS\r\n(\r\n    SELECT\r\n        Marca,\r\n        CodSucursala,\r\n        CodBanca,\r\n        ContIBAN\r\n    FROM CarduriBanci\r\n\r\n    UNION ALL\r\n\r\n    SELECT\r\n        co.Marca,\r\n        co.CodSucursala,\r\n        'CASH' AS CodBanca,\r\n        NULL AS ContIBAN\r\n    FROM app.ConcediudeOdihna co\r\n    WHERE co.Avans = 'D'\r\n      --AND co.NumarStatPlata = @NumarStatPlata\r\n      AND co.CodSucursala   = @CodSucursala\r\n      AND co.Anul           = @Anul\r\n      AND co.Luna           = @Luna\r\n      AND NOT EXISTS\r\n      (\r\n          SELECT 1\r\n          FROM CarduriBanci cb\r\n          WHERE cb.Marca = co.Marca\r\n            AND cb.CodSucursala = co.CodSucursala\r\n      )\r\n)\r\n\r\n\r\nINSERT INTO app.StatPlataCO\r\n(\r\n    -------------------------------------------------\r\n    -- Identificare\r\n    -------------------------------------------------\r\n    Anul,\r\n    Luna,\r\n    CodSucursala,\r\n    Marca,\r\n    Nume,\r\n    \r\n    \r\n\r\n    -------------------------------------------------\r\n    -- Stat plata\r\n    -------------------------------------------------\r\n    CodBanca,\r\n    DenumireBanca,\r\n    ContIBAN,\r\n\r\n    NumarStatPlata,\r\n    DataPlatii,\r\n    TipPlata,\r\n\r\n    -------------------------------------------------\r\n    -- Perioada CO\r\n    -------------------------------------------------\r\n    DatadeInceput,\r\n    DatadeSfarsit,\r\n    ZileCO,\r\n\r\n    -------------------------------------------------\r\n    -- Avansuri\r\n    -------------------------------------------------\r\n    AvansCO1,\r\n    AvansCO2,\r\n    AvansCO3,\r\n    TotalAvans,\r\n\r\n    -------------------------------------------------\r\n    -- Audit\r\n    -------------------------------------------------\r\n    Status,\r\n    CreatedDate,\r\n    CreatedBy\r\n)\r\n\r\nSELECT\r\n\r\n    -------------------------------------------------\r\n    -- Identificare\r\n    -------------------------------------------------\r\n    co.Anul,\r\n    co.Luna,\r\n    co.CodSucursala,\r\n    co.Marca,\r\n    s.Nume,\r\n\r\n    -------------------------------------------------\r\n    -- Stat plata\r\n    -------------------------------------------------\r\n    c.CodBanca,\r\n    bc.DenumireBanca,\r\n    c.ContIBAN,\r\n\r\n    co.NumarStatPlata,\r\n    @DataPlatii,\r\n    \r\n    'AVANS CONCEDII',\r\n    \r\n    -------------------------------------------------\r\n    -- Perioada CO\r\n    -------------------------------------------------\r\n    co.DatadeInceput,\r\n    co.DatadeSfarsit,\r\n    ISNULL(co.ZileCO,0),\r\n\r\n    -------------------------------------------------\r\n    -- Avansuri\r\n    -------------------------------------------------\r\n    ISNULL(co.AvansCO1,0),\r\n    ISNULL(co.AvansCO2,0),\r\n    ISNULL(co.AvansCO3,0),\r\n\r\n    ISNULL(co.AvansCO1,0)\r\n  + ISNULL(co.AvansCO2,0)\r\n  + ISNULL(co.AvansCO3,0),\r\n\r\n    -------------------------------------------------\r\n    -- Audit\r\n    -------------------------------------------------\r\n    1,\r\n    SYSDATETIMEOFFSET(),\r\n    @UserId\r\n\r\nFROM app.ConcediudeOdihna co\r\n\r\nLEFT JOIN app.Salariat s\r\n       ON s.Marca         = co.Marca\r\n      AND s.CodSucursala  = co.CodSucursala\r\n      AND s.Anul          = co.Anul\r\n      AND s.Luna          = co.Luna\r\n\r\nLEFT JOIN Carduri c\r\n       ON c.Marca = co.Marca\r\n      AND c.CodSucursala = co.CodSucursala\r\n\r\nLEFT JOIN app.BancaCard bc\r\n       ON bc.CodBanca = c.CodBanca\r\n\r\nWHERE co.Avans = 'D'\r\n  --AND co.NumarStatPlata = @NumarStatPlata\r\n  AND co.CodSucursala   = @CodSucursala\r\n  AND co.Anul           = @Anul\r\n  AND co.Luna           = @Luna\r\n\r\nORDER BY s.Nume;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
