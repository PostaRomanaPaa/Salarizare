          },
          {
            "Id": 38963,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 8661,
            "Name": "SqlQuery",
            "Value": "DECLARE @CodClient NVARCHAR(50);\r\nDECLARE @Acum DATETIME = GETDATE();\r\n\r\nIF ISNULL(@ZileLucratoare, 0) <= 0\r\nBEGIN\r\n    ;THROW 51000, N'Numărul zilelor lucrătoare trebuie să fie mai mare decât zero.', 1;\r\nEND;\r\n\r\nSELECT TOP (1)\r\n    @CodClient = LTRIM(RTRIM(CONVERT(NVARCHAR(50), s.CodclientEdenred)))\r\nFROM app.Sucursala AS s\r\nWHERE LTRIM(RTRIM(s.CodSucursala)) = LTRIM(RTRIM(@CodSucursala));\r\n\r\nIF NULLIF(@CodClient, N'') IS NULL\r\nBEGIN\r\n    ;THROW 51000, N'Lipsește Cod client Edenred pentru sucursala curentă.', 1;\r\nEND;\r\n\r\nIF NOT EXISTS\r\n(\r\n    SELECT 1\r\n    FROM app.TichetMasa AS tm\r\n    WHERE LTRIM(RTRIM(tm.CodSucursala)) = LTRIM(RTRIM(@CodSucursala))\r\n      AND tm.Anul = @Anul\r\n      AND tm.Luna = @Luna\r\n      AND ISNULL(tm.Status, 1) = 2\r\n      AND ISNULL(tm.NrTMTotal, 0) > 0\r\n)\r\nBEGIN\r\n    ;THROW 51000, N'Nu există tichete de masă confirmate, cu valoare pozitivă, pentru sucursala și perioada selectate.', 1;\r\nEND;\r\n\r\nSELECT\r\n    @CodClient + N'-'\r\n    + RIGHT(N'0' + CONVERT(NVARCHAR(2), DAY(@Acum)), 2)\r\n    + RIGHT(N'0' + CONVERT(NVARCHAR(2), MONTH(@Acum)), 2)\r\n    + RIGHT(CONVERT(NVARCHAR(4), YEAR(@Acum)), 2)\r\n    + RIGHT(N'0' + CONVERT(NVARCHAR(2), DATEPART(HOUR, @Acum)), 2)\r\n    + RIGHT(N'0' + CONVERT(NVARCHAR(2), DATEPART(MINUTE, @Acum)), 2)\r\n    + N'-TR' AS NumeFisierCsv;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
          },
