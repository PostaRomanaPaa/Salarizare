            "LastModifiedBy": null
          },
          {
            "Id": 38972,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 8662,
            "Name": "SqlQuery",
            "Value": "SELECT\r\n    LTRIM(RTRIM(CONVERT(NVARCHAR(50), s.CodclientEdenred))) AS CodClient,\r\n    N'1' AS Constanta1,\r\n    N'1' AS Constanta2,\r\n    N'1' AS NrCarnete,\r\n    CONVERT(NVARCHAR(10), CONVERT(INT, ISNULL(tm.NrTMTotal, 0))) AS NrTichete,\r\n    REPLACE(\r\n        CONVERT(\r\n            NVARCHAR(30),\r\n            CAST(ISNULL(tm.ValoareTichet, 0) AS DECIMAL(18, 2))\r\n        ),\r\n        N'.',\r\n        N','\r\n    ) AS ValoareTichet,\r\n    LEFT(\r\n        ISNULL(RTRIM(CONVERT(NVARCHAR(50), tm.CodOficiu)), N'')\r\n        + REPLICATE(N' ', 10),\r\n        10\r\n    ) AS CodOficiu,\r\n    LEFT(\r\n        ISNULL(RTRIM(CONVERT(NVARCHAR(200), tm.Nume)), N'')\r\n        + REPLICATE(N' ', 30),\r\n        30\r\n    ) AS Nume,\r\n    LEFT(\r\n        ISNULL(RTRIM(CONVERT(NVARCHAR(50), tm.CNP)), N'')\r\n        + REPLICATE(N' ', 13),\r\n        13\r\n    ) AS CNP,\r\n    N'P' AS TipBeneficiar,\r\n    CONVERT(NVARCHAR(10), @ZileLucratoare) AS ZileLucratoare,\r\n    CONVERT(\r\n        NVARCHAR(10),\r\n        CONVERT(INT, ISNULL(tm.ZileLucrateTotal, 0))\r\n    ) AS ZileLucrate,\r\n    N'' AS FinalGol\r\nFROM app.TichetMasa AS tm\r\nINNER JOIN app.Sucursala AS s\r\n    ON LTRIM(RTRIM(s.CodSucursala)) = LTRIM(RTRIM(tm.CodSucursala))\r\nWHERE LTRIM(RTRIM(tm.CodSucursala)) = LTRIM(RTRIM(@CodSucursala))\r\n  AND tm.Anul = @Anul\r\n  AND tm.Luna = @Luna\r\n  AND ISNULL(tm.Status, 1) = 2\r\n  AND ISNULL(tm.NrTMTotal, 0) > 0\r\nORDER BY\r\n    tm.CodOficiu,\r\n    tm.Marca,\r\n    tm.Id;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
          },
