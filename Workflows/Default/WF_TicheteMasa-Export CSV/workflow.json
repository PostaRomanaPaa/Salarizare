      {
        "Id": 8662,
        "GlobalId": "00000000-0000-0000-0000-000000000000",
        "Description": "Construiește lista de linii CSV Edenred",
        "ActionErrorMessage": null,
        "ActionStackId": 11659,
        "ActionType": "LoadEntitiesFromSql",
        "Condition": null,
        "IsDeleted": false,
        "IsDisabled": false,
        "OrderIndex": 1,
        "DiagramUID": "Activity_0z0nj5u",
        "ActionParameters": [
          {
            "Id": 38970,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 8662,
            "Name": "ConnectionString",
            "Value": null,
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
          },
          {
            "Id": 38971,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 8662,
            "Name": "QueryTimeout",
            "Value": null,
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
