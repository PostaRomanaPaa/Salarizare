            "ActionId": 8748,
            "Name": "SqlQuery",
            "Value": "UPDATE app.FisierEdenred\r\nSET\r\n    DataTransmitere = GETDATE(),\r\n    EmailDestinatar = @Email,\r\n    MesajTransmitere = N'Fișiere Edenred transmise prin e-mail.'\r\nWHERE Anul = @Anul\r\n  AND Luna = @Luna\r\n  AND FileId IN\r\n  (\r\n      SELECT TRY_CAST(value AS INT)\r\n      FROM STRING_SPLIT(@ListaFisiere, N',')\r\n  );",
