          {
            "Id": 39251,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 8745,
            "Name": "SqlQuery",
            "Value": "DECLARE @TotalSucursale INT;\r\nDECLARE @FisiereGenerate INT;\r\n\r\nDECLARE @FisiereCurente TABLE\r\n(\r\n    CodSucursala   NVARCHAR(50)  NOT NULL PRIMARY KEY,\r\n    FileId         INT           NOT NULL,\r\n    DenumireFisier NVARCHAR(260) NULL\r\n);\r\n\r\nSELECT\r\n    @TotalSucursale =\r\n        COUNT(DISTINCT LTRIM(RTRIM(s.CodSucursala)))\r\nFROM app.Sucursala AS s\r\nWHERE NULLIF(LTRIM(RTRIM(s.CodSucursala)), N'') IS NOT NULL;\r\n\r\n;WITH FisiereClasificate AS\r\n(\r\n    SELECT\r\n        LTRIM(RTRIM(fe.CodSucursala)) AS CodSucursala,\r\n        fe.FileId,\r\n        fe.DenumireFisier,\r\n\r\n        ROW_NUMBER() OVER\r\n        (\r\n            PARTITION BY LTRIM(RTRIM(fe.CodSucursala))\r\n            ORDER BY\r\n                fe.DataGenerare DESC,\r\n                fe.Id DESC\r\n        ) AS NumarOrdine\r\n\r\n    FROM app.FisierEdenred AS fe\r\n\r\n    INNER JOIN Files AS f\r\n        ON f.FileId = fe.FileId\r\n\r\n    INNER JOIN app.Sucursala AS s\r\n        ON LTRIM(RTRIM(s.CodSucursala))\r\n         = LTRIM(RTRIM(fe.CodSucursala))\r\n\r\n    WHERE fe.Anul = @Anul\r\n      AND fe.Luna = @Luna\r\n)\r\nINSERT INTO @FisiereCurente\r\n(\r\n    CodSucursala,\r\n    FileId,\r\n    DenumireFisier\r\n)\r\nSELECT\r\n    CodSucursala,\r\n    FileId,\r\n    DenumireFisier\r\nFROM FisiereClasificate\r\nWHERE NumarOrdine = 1;\r\n\r\nSELECT\r\n    @FisiereGenerate = COUNT(*)\r\nFROM @FisiereCurente;\r\n\r\nSELECT\r\n    CASE\r\n        WHEN @TotalSucursale > 0\r\n         AND @FisiereGenerate = @TotalSucursale\r\n        THEN 1\r\n        ELSE 0\r\n    END AS EstePregatit,\r\n\r\n    CASE\r\n        WHEN @TotalSucursale > 0\r\n         AND @FisiereGenerate = @TotalSucursale\r\n        THEN N''\r\n        ELSE\r\n            N'Transmiterea nu este permisă: există '\r\n            + CONVERT(NVARCHAR(10), ISNULL(@FisiereGenerate, 0))\r\n            + N' fișiere Edenred generate din '\r\n            + CONVERT(NVARCHAR(10), ISNULL(@TotalSucursale, 0))\r\n            + N' sucursale. Generează fișierele lipsă și încearcă din nou.'\r\n    END AS MesajBlocare,\r\n\r\n    STRING_AGG(\r\n        CAST(fc.FileId AS NVARCHAR(MAX)),\r\n        N','\r\n    ) WITHIN GROUP (\r\n        ORDER BY fc.CodSucursala\r\n    ) AS FileIds,\r\n\r\n    STRING_AGG(\r\n        CAST(\r\n            N'<li>'\r\n            + ISNULL(fc.DenumireFisier, N'')\r\n            + N'</li>'\r\n            AS NVARCHAR(MAX)\r\n        ),\r\n        N''\r\n    ) WITHIN GROUP (\r\n        ORDER BY fc.CodSucursala\r\n    ) AS NumeFisiere,\r\n\r\n    CONVERT(NVARCHAR(10), ISNULL(@FisiereGenerate, 0))\r\n    + N'/'\r\n    + CONVERT(NVARCHAR(10), ISNULL(@TotalSucursale, 0))\r\n    AS RezumatFisiere\r\n\r\nFROM @FisiereCurente AS fc;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
