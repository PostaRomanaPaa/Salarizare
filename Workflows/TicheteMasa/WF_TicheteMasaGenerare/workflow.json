          },
          {
            "Id": 37118,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 8362,
            "Name": "SqlQuery",
            "Value": "DELETE FROM app.TichetMasa\r\nWHERE CodSucursala = @CodSucursala\r\n  AND Anul = @Anul\r\n  AND Luna = @Luna\r\n  AND ISNULL(Status, 1) IN (1, 7);\r\n\r\n;WITH Corectii AS\r\n(\r\n    SELECT\r\n        CodSucursala,\r\n        Anul,\r\n        Luna,\r\n        Marca,\r\n        SUM(ISNULL(Corectie, 0)) AS Corectie\r\n    FROM app.TichetMasaCorectii\r\n    WHERE CodSucursala = @CodSucursala\r\n      AND Anul = @Anul\r\n      AND Luna = @Luna\r\n      AND ISNULL(Status, 1) = 2\r\n    GROUP BY\r\n        CodSucursala,\r\n        Anul,\r\n        Luna,\r\n        Marca\r\n),\r\nValoareTichet AS\r\n(\r\n    SELECT\r\n        Anul,\r\n        Luna,\r\n        MAX(Valoare) AS Valoare\r\n    FROM app.TSTichetMasa\r\n    WHERE Anul = @Anul\r\n      AND Luna = @Luna\r\n    GROUP BY\r\n        Anul,\r\n        Luna\r\n)\r\nINSERT INTO app.TichetMasa\r\n(\r\n    CNP,\r\n    CodOficiu,\r\n    CodSucursala,\r\n    CreatedBy,\r\n    CreatedDate,\r\n    LastModifiedBy,\r\n    LastModifiedDate,\r\n    Judet,\r\n    Marca,\r\n    Nume,\r\n    Anul,\r\n    Luna,\r\n    TipNorma,\r\n    OreLucrate,\r\n    ZileDelegatie,\r\n    ZileLiberePlatite,\r\n    ZLPIngrijire,\r\n    ZileLucrateTotal,\r\n    NumarTicheteMasa,\r\n    Corectie,\r\n    TicheteNecuvenite,\r\n    NrTMTotal,\r\n    ValoareTichet,\r\n    SumaTicheteMasa,\r\n    Status\r\n)\r\nSELECT\r\n    s.CNP,\r\n    s.CodLocMunca,\r\n    ep.CodSucursala,\r\n    ep.CreatedBy,\r\n    ep.CreatedDate,\r\n    ep.LastModifiedBy,\r\n    ep.LastModifiedDate,\r\n    ep.Judet,\r\n    ep.Marca,\r\n    s.Nume,\r\n    ep.Anul,\r\n    ep.Luna,\r\n    ISNULL(ep.TipNorma, 1),\r\n    ISNULL(ep.OreLucrate, 0),\r\n    ISNULL(ep.ZileDelegatie, 0),\r\n    ISNULL(ep.ZileLiberePlatite, 0),\r\n    ISNULL(ep.ZLPIngrijire, 0),\r\n    ISNULL(ep.ZileLucrateTotal, 0),\r\n    calcul.NumarTicheteMasa,\r\n    ISNULL(c.Corectie, 0),\r\n    0,\r\n    total.NrTMTotal,\r\n    ISNULL(vt.Valoare, 0),\r\n    total.NrTMTotal * ISNULL(vt.Valoare, 0),\r\n    1\r\nFROM app.ExceptiiPrezenta ep\r\nINNER JOIN app.Salariat s\r\n    ON s.Marca = ep.Marca\r\n   AND s.CodSucursala = ep.CodSucursala\r\n   AND s.Anul = ep.Anul\r\n   AND s.Luna = ep.Luna\r\nLEFT JOIN Corectii c\r\n    ON c.Marca = ep.Marca\r\n   AND c.CodSucursala = ep.CodSucursala\r\n   AND c.Anul = ep.Anul\r\n   AND c.Luna = ep.Luna\r\nLEFT JOIN ValoareTichet vt\r\n    ON vt.Anul = ep.Anul\r\n   AND vt.Luna = ep.Luna\r\nCROSS APPLY\r\n(\r\n    SELECT\r\n        CASE\r\n            WHEN ISNULL(ep.ZileLucrateTotal, 0)\r\n               - ISNULL(ep.ZileDelegatie, 0)\r\n               - ISNULL(ep.ZileLiberePlatite, 0)\r\n               - ISNULL(ep.ZLPIngrijire, 0) < 0\r\n            THEN 0\r\n            ELSE ISNULL(ep.ZileLucrateTotal, 0)\r\n               - ISNULL(ep.ZileDelegatie, 0)\r\n               - ISNULL(ep.ZileLiberePlatite, 0)\r\n               - ISNULL(ep.ZLPIngrijire, 0)\r\n        END AS NumarTicheteMasa\r\n) calcul\r\nCROSS APPLY\r\n(\r\n    SELECT\r\n        CASE\r\n            WHEN calcul.NumarTicheteMasa + ISNULL(c.Corectie, 0) < 0\r\n            THEN 0\r\n            ELSE calcul.NumarTicheteMasa + ISNULL(c.Corectie, 0)\r\n        END AS NrTMTotal\r\n) total\r\nWHERE ep.CodSucursala = @CodSucursala\r\n  AND ep.Anul = @Anul\r\n  AND ep.Luna = @Luna;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
